DATABASE_URL="postgresql://solen_user:CHANGE_ME_PASSWORD@localhost:5432/solen_db?schema=public"
JWT_SECRET="generate_a_secure_random_jwt_secret_key_here"
PORT=3333
GEMINI_API_KEY="your_gemini_api_key"
NVIDIA_API_KEY="your_nvidia_api_key"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_smtp_app_password"

# Segredo para validação de webhooks de pagamento (Stripe/Asaas)
WEBHOOK_SECRET="your_webhook_secret_key"

# Origens permitidas no CORS (separadas por vírgula em produção, ex: https://app.solen.com)
CORS_ORIGIN="*"
